# LLM Judge Configuration
JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct
JUDGE_API_KEY=

# Generator Model (Decoupled family to avoid self-enhancement)
GENERATOR_MODEL=mistralai/mistral-7b-instruct
GENERATOR_API_KEY=

# General OpenRouter API key
OPENROUTER_API_KEY=

# Bias Mitigation Controls
ENABLE_POSITION_SWAP=true
ENABLE_LENGTH_PENALTY=true
MAX_VERBOSITY_RATIO=2.5

# Audit Logging
AUDIT_LOG_PATH=./logs/judge_audit.jsonl
